@page
@model _2026web3.Pages.Personas.IndexModel
@{
    ViewData["Title"] = "Personas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Personas</h1>
        <p class="text-muted mb-0">Administra personas y sus relaciones con país, pasaporte y materias.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Nueva persona</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model.Personas.Count == 0)
{
    <div class="alert alert-info">
        Todavía no hay personas registradas. <a asp-page="Create" class="alert-link">Crea la primera</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Fecha de nacimiento</th>
                    <th>País</th>
                    <th>Pasaporte</th>
                    <th>Materias</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var persona in Model.Personas)
            {
                <tr>
                    <td>@persona.Name</td>
                    <td>@persona.dob.ToString("dd/MM/yyyy")</td>
                    <td>@persona.Pais.Name</td>
                    <td>@persona.Pasaporte?.Numero</td>
                    <td>
                        @if (persona.Materias.Count == 0)
                        {
                            <span class="text-muted">Sin materias</span>
                        }
                        else
                        {
                            @string.Join(", ", persona.Materias.OrderBy(m => m.Name).Select(m => m.Name))
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-page="Details" asp-route-id="@persona.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-page="Edit" asp-route-id="@persona.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-page="Delete" asp-route-id="@persona.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
